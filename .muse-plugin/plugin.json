{
  "schemaVersion": 1,
  "name": "deliverd",
  "displayName": "Deliverd",
  "version": "1.3.0",
  "description": "Human-in-the-loop for Muse Code: before a consequential action, the agent asks a named person, or your organisation's policy, through Deliverd and acts on the answer. Bundles the Deliverd MCP server (OAuth sign-in, no key to paste) and the approval, tasks, ethics, artifact and compliance skills.",
  "logo": "assets/icon.png",
  "author": { "name": "Deliverd", "url": "https://deliverd.dev" },
  "compat": { "source": "native", "manifestDir": ".muse-plugin" },
  "capabilities": {
    "skills": [
      { "id": "approval", "path": "skills/approval/SKILL.md", "enabledDefault": true },
      { "id": "tasks", "path": "skills/tasks/SKILL.md", "enabledDefault": true },
      { "id": "ethics", "path": "skills/ethics/SKILL.md", "enabledDefault": true },
      { "id": "artifact", "path": "skills/artifact/SKILL.md", "enabledDefault": true },
      { "id": "compliance", "path": "skills/compliance/SKILL.md", "enabledDefault": true }
    ],
    "mcpServers": [
      { "id": "deliverd", "transport": "http", "url": "https://deliverd.dev/api/mcp" }
    ]
  }
}
